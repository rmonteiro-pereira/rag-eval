# Copy to .env and adjust. Every value below is a local-only default; there are
# no paid APIs and no secrets in this project.

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=bacen_copom

# --- Embeddings (local, HuggingFace) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4

# --- Chunking (M1 naive baseline) ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5

# --- Generation ---
# auto | ollama | extractive
LLM_MODE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Langfuse (self-hosted; keys are auto-provisioned by docker-compose) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-rag-eval-local
LANGFUSE_SECRET_KEY=sk-lf-rag-eval-local
LANGFUSE_ENABLED=true
