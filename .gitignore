# --- secrets ---
.env
.env.local
*.key

# --- corpus & artifacts (never commit raw docs or weights) ---
# (`data/*` not `data/` — git cannot re-include a file whose parent dir is excluded)
data/*
!data/manifest.json
models/
*.pdf
*.safetensors
*.bin
*.gguf
*.onnx

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
uv.lock.bak
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- local infra state ---
.docker-data/
qdrant_storage/
langfuse_data/

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- eval run outputs (reports are regenerated) ---
eval/reports/*.json
eval/reports/*.html
# ...except the reports a milestone actually claims a result from. These are
# the evidence behind every number in docs/, so they are committed with their
# full per-query audit trail rather than summarised: a report you cannot drill
# into is a number you have to take on faith.
!eval/reports/baseline_dense.json
!eval/reports/ablation.json
!eval/reports/generation.json
!eval/reports/adversarial.json
!eval/reports/mutation.json
mutants/
